GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
FRONTEND_ORIGIN=http://localhost:3000
ATLAS_TRUST_THRESHOLD=0.65

# Vector storage: memory (default, nothing persisted), sqlite, or faiss (needs faiss-cpu)
VECTOR_STORE_BACKEND=memory
VECTOR_STORE_PATH=data/atlas_memory.db

# Optional NLI contradiction check (needs sentence-transformers). Off by default: on the
# included benchmark it adds no recall and adds false positives.
USE_NLI=false
